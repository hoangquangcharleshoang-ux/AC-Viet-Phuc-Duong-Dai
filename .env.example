# CUSTOM_GEMINI_API_KEY / GEMINI_API_KEY: Required for Gemini AI API calls.
# CUSTOM_GEMINI_API_KEY takes priority over GEMINI_API_KEY if provided.
# AI Studio automatically injects GEMINI_API_KEY at runtime from user secrets.
CUSTOM_GEMINI_API_KEY=""
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Phase 2B: Configurable Image Generation Transport
IMAGE_PROVIDER="gemini"
IMAGE_API_KEY=""
IMAGE_API_BASE_URL=""
IMAGE_PROVIDER_MODEL="req/gemini-3.0-pro-image"
IMAGE_GENERATION_TIMEOUT_MS="110000"
IMAGE_SERVER_TOTAL_DEADLINE_MS="115000"
IMAGE_EPHEMERAL_TTL_MS="900000"

